{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "User wellness profile details, counters and indicators.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gender": { "type": "string", "enum": ["homem", "mulher", "outro"] },
        "age": { "type": "integer" },
        "selectedGoals": { "type": "array" },
        "restrictions": { "type": "array" },
        "preferredDuration": { "type": "integer" },
        "selectedEquipment": { "type": "array" },
        "workoutsCompleted": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "hydrationMl": { "type": "integer" },
        "targetHydrationMl": { "type": "integer" },
        "weightKg": { "type": "integer" },
        "muscleMassPercent": { "type": "integer" },
        "biologicalAge": { "type": "number" },
        "hrvBaseline": { "type": "integer" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "customExercises": { "type": "array" }
      },
      "required": ["name", "gender", "age", "selectedGoals", "restrictions", "workoutsCompleted", "streakDays", "hydrationMl", "targetHydrationMl", "weightKg", "muscleMassPercent", "biologicalAge", "hrvBaseline"]
    },
    "admin": {
      "title": "Admin",
      "description": "Administrator flag list linked to key uids.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "workout_announcement": {
      "title": "WorkoutAnnouncement",
      "description": "Special workout challenges or messages posted by administrators.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "global_exercise": {
      "title": "GlobalExercise",
      "description": "New custom physical exercises added globally by administrative personal trainers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["strength", "cardio", "mobility", "longevity"] },
        "duration": { "type": "integer" },
        "description": { "type": "string" },
        "formTip": { "type": "string" },
        "adaptedFor": { "type": "string" },
        "imageUrl": { "type": "string" },
        "steps": { "type": "array" },
        "donts": { "type": "array" },
        "targetJoints": { "type": "array" }
      },
      "required": ["id", "name", "category"]
    },
    "sequence": {
      "title": "Sequence",
      "description": "Custom sequence/routine generated by administrators for the program with objectives and coach name.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "totalDuration": { "type": "integer" },
        "exercises": { "type": "array" },
        "estimatedCalories": { "type": "integer" },
        "personalTrainerName": { "type": "string" }
      },
      "required": ["id", "title", "description", "category", "totalDuration", "exercises"]
    },
    "recording": {
      "title": "Recording",
      "description": "Workout recordings captured by student cameras and submitted to the database.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "exerciseId": { "type": "string" },
        "exerciseName": { "type": "string" },
        "videoUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "trainerFeedback": { "type": "string" },
        "trainerFeedbackAnnotatedImage": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "exerciseId", "exerciseName", "videoUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User state profile documents"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Uids representing system administrators"
    },
    "/challenges/{challengeId}": {
      "schema": "workout_announcement",
      "description": "Challenges and notifications for users"
    },
    "/global_exercises/{exerciseId}": {
      "schema": "global_exercise",
      "description": "Global exercise repository"
    },
    "/sequences/{sequenceId}": {
      "schema": "sequence",
      "description": "Clinically generated program sequences and training blueprints"
    },
    "/recordings/{recordingId}": {
      "schema": "recording",
      "description": "Student execution video recordings for review"
    }
  }
}